{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/1second1/personal-research-skills/blob/master/evals/schemas/run-record-v1.schema.json",
  "title": "Personal Research Skills run record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "task_id",
    "condition",
    "repetition",
    "created_at",
    "repository_revision",
    "model",
    "generation",
    "artifacts",
    "digests",
    "review"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "run_id": {"type": "string", "minLength": 1},
    "task_id": {"type": "string", "minLength": 1},
    "condition": {"enum": ["baseline", "skill", "profile"]},
    "repetition": {"type": "integer", "minimum": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "repository_revision": {"type": "string", "minLength": 1},
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "name", "version"],
      "properties": {
        "provider": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1}
      }
    },
    "generation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["temperature", "seed", "max_output_tokens", "tools"],
      "properties": {
        "temperature": {"type": "number", "minimum": 0},
        "seed": {"type": ["integer", "null"]},
        "max_output_tokens": {"type": "integer", "minimum": 1},
        "tools": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input", "context", "output"],
      "properties": {
        "input": {"type": "string", "minLength": 1},
        "context": {"type": "string", "minLength": 1},
        "output": {"type": "string", "minLength": 1}
      }
    },
    "digests": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input", "context", "output"],
      "properties": {
        "input": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "context": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "output": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": {"enum": ["unreviewed", "reviewed", "excluded"]}
      }
    }
  }
}
